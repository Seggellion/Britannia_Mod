# UltimaCraft Minecraft host environment — EXAMPLE ONLY, placeholders only.
#
# The SAME four variables are read by the Britannia NeoForge server and the
# Atrevion Fabric server, with the same meanings, the same validation and the
# same precedence. Deploying either mod on a host means changing the VALUES
# below, not the names.
#
# Copy to your host's environment (systemd unit, container env, panel config)
# and fill in the real values THERE. Never commit a filled-in copy.
#
# Precedence: environment (name + secret together) wins and the file is not
# read at all; otherwise config/britannia_mod-server.properties, with the
# server key and the origin each overriding only themselves. A change needs a
# restart.

# The shard this server authenticates as; must match Rails `shards.name`.
ULTIMACRAFT_SHARD_NAME=Britannia

# The shard credential. Rails calls this column `client_secret` — same value,
# 64 lowercase hex characters from the Rails admin.
#
# SECRET. Server-only. Never reaches a client; only an 8-character fingerprint
# is ever logged. Rotate with `Shard#rotate_client_secret!` (24-hour
# dual-accept window), never a bare `update!`.
ULTIMACRAFT_SHARD_SECRET=<shard-client-secret>

# This server's identity in Rails. It IS `minecraft_servers.public_id` — there
# is no separate server-key column. Created only through the Rails admin UI.
#
# SECRET. Server-only. Without it, banking, world-state sync and NPC spawning
# fail closed at authentication.
ULTIMACRAFT_MINECRAFT_SERVER_KEY=<minecraft-server-public-id>

# The Rails origin: scheme and host only, no path or query. A trailing /api or
# /api/ is tolerated and stripped. HTTPS is required for every host except
# explicit loopback (localhost, 127.0.0.1, ::1).
#
# Required whenever the name and secret come from the environment. If it is
# missing, the server refuses to start a trusted session and names this
# variable, rather than substituting a default. (Before the NF-002 repair,
# NeoForge ignored this variable and used a compiled loopback constant.)
ULTIMACRAFT_API_BASE_URL=https://<rails-origin>

# ---------------------------------------------------------------------------
# File-only settings, no environment equivalent on either mod. Both default to
# false, in config/britannia_mod-server.properties:
#   allow_integrated_server        trust a single-player integrated server
#                                  (also requires a loopback origin)
#   rails_update_listener_enabled  enable the Rails update listener
