package com.seggellion.britannia_mod.network.payload;

import com.seggellion.britannia_mod.block.entity.BritanniaSpawnBlockEntity;
import net.minecraft.core.BlockPos;
import net.minecraft.network.FriendlyByteBuf;
import net.minecraft.network.codec.ByteBufCodecs;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.world.level.Level;

public record UpdateSpawnerConfigC2SPayload(
        BlockPos pos,
        ResourceLocation entityId,
        int radius,
        int minTicks,
        int maxTicks,
        boolean nightOnly
) implements CustomPacketPayload {

    public static final ResourceLocation TYPE_ID = ResourceLocation.fromNamespaceAndPath("britannia_mod", "update_spawner_config");
    public static final Type<UpdateSpawnerConfigC2SPayload> TYPE = new Type<>(TYPE_ID);

    public static final StreamCodec<FriendlyByteBuf, UpdateSpawnerConfigC2SPayload> STREAM_CODEC =
            StreamCodec.composite(
                    BlockPos.STREAM_CODEC, UpdateSpawnerConfigC2SPayload::pos,
                    ResourceLocation.STREAM_CODEC, UpdateSpawnerConfigC2SPayload::entityId,
                    ByteBufCodecs.VAR_INT, UpdateSpawnerConfigC2SPayload::radius,
                    ByteBufCodecs.VAR_INT, UpdateSpawnerConfigC2SPayload::minTicks,
                    ByteBufCodecs.VAR_INT, UpdateSpawnerConfigC2SPayload::maxTicks,
                    ByteBufCodecs.BOOL, UpdateSpawnerConfigC2SPayload::nightOnly,
                    UpdateSpawnerConfigC2SPayload::new
            );

    @Override public Type<? extends CustomPacketPayload> type() { return TYPE; }

    /** Server-side handler */
    public static void handle(UpdateSpawnerConfigC2SPayload pkt, ServerPlayer player) {
        if (player == null) return;
        // Admin/creative gate on the server too (defense in depth)
        boolean isAdmin = player.isCreative() || player.hasPermissions(2);
        if (!isAdmin) return;

        Level level = player.level();
        var be = level.getBlockEntity(pkt.pos());
        if (be instanceof BritanniaSpawnBlockEntity spawner) {
            spawner.applyConfig(pkt.entityId(), pkt.radius(), pkt.minTicks(), pkt.maxTicks(), pkt.nightOnly());
        }
    }
}
