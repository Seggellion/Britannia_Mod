package com.seggellion.britannia_mod.network;

import com.seggellion.britannia_mod.block.entity.BritanniaSpawnBlockEntity;
import net.minecraft.core.BlockPos;
import net.minecraft.network.FriendlyByteBuf;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.server.level.ServerPlayer;

public record UpdateSpawnerConfigC2S(BlockPos pos, ResourceLocation entityId, int radius, int minTicks, int maxTicks, boolean nightOnly)
        implements NetworkHandler.C2SMessage<UpdateSpawnerConfigC2S> {

    public static UpdateSpawnerConfigC2S read(FriendlyByteBuf buf) {
        return new UpdateSpawnerConfigC2S(buf.readBlockPos(), buf.readResourceLocation(), buf.readVarInt(), buf.readVarInt(), buf.readVarInt(), buf.readBoolean());
    }

    @Override public void write(FriendlyByteBuf buf) {
        buf.writeBlockPos(pos);
        buf.writeResourceLocation(entityId);
        buf.writeVarInt(radius);
        buf.writeVarInt(minTicks);
        buf.writeVarInt(maxTicks);
        buf.writeBoolean(nightOnly);
    }

    @Override
    public void handle(ServerPlayer player) {
        if (player == null || player.level().isClientSide) return;
        boolean isAdmin = player.isCreative() || player.hasPermissions(2);
        if (!isAdmin) return;

        if (player.level().getBlockEntity(pos) instanceof BritanniaSpawnBlockEntity be) {
            be.applyConfig(entityId, radius, minTicks, maxTicks, nightOnly);
        }
    }
}
