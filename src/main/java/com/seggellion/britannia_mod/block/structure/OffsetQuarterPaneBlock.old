package com.seggellion.britannia_mod.block;

import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.world.item.context.BlockPlaceContext;
import net.minecraft.world.level.LevelAccessor;
import net.minecraft.world.level.block.IronBarsBlock;
import net.minecraft.world.level.block.SoundType;
import net.minecraft.world.level.block.state.BlockBehaviour;
import net.minecraft.world.level.block.state.BlockState;
import net.minecraft.world.level.block.state.StateDefinition;
import net.minecraft.world.level.block.state.properties.BooleanProperty;
import net.minecraft.world.level.block.state.properties.DirectionProperty;
import net.minecraft.world.level.block.state.properties.BlockStateProperties;
import net.minecraft.world.level.material.MapColor;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.phys.shapes.VoxelShape;
import net.minecraft.world.phys.shapes.Shapes;
import net.minecraft.world.level.BlockGetter;
import net.minecraft.world.phys.shapes.CollisionContext;

public class OffsetQuarterPaneBlock extends IronBarsBlock {

    /** remembers which edge we show when the block is isolated */
    public static final DirectionProperty FACING = BlockStateProperties.HORIZONTAL_FACING;

    public OffsetQuarterPaneBlock() {
        super(BlockBehaviour.Properties.of()
                .mapColor(MapColor.WOOD)
                .strength(1.0f)
                .sound(SoundType.WOOD)
                .noOcclusion());
        this.registerDefaultState(this.defaultBlockState()
                .setValue(NORTH,false).setValue(EAST,false)
                .setValue(SOUTH,false).setValue(WEST,false)
                .setValue(FACING, Direction.NORTH));
    }

    @Override
    protected void createBlockStateDefinition(StateDefinition.Builder<Block,BlockState> b) {
        super.createBlockStateDefinition(b);
        b.add(FACING);
    }

   @Override
public BlockState getStateForPlacement(BlockPlaceContext ctx) {
    BlockPos pos = ctx.getClickedPos();
    BlockState base = super.getStateForPlacement(ctx);

    // First: scan for existing neighbor wall
    for (Direction d : Direction.Plane.HORIZONTAL) {
        BlockPos neighborPos = pos.relative(d);
        BlockState neighbor = ctx.getLevel().getBlockState(neighborPos);

        if (neighbor.getBlock() instanceof OffsetQuarterPaneBlock) {
            // Set connection side, but do NOT touch fallback FACING
            BooleanProperty thisFlag  = PROPERTY_BY_DIRECTION.get(d);
            BooleanProperty otherFlag = PROPERTY_BY_DIRECTION.get(d.getOpposite());

            BlockState updated = base.setValue(thisFlag, true);

            // Update the neighbor immediately
            ctx.getLevel().setBlock(neighborPos, neighbor.setValue(otherFlag, true), Block.UPDATE_CLIENTS);

            return updated;
        }
    }

    // No neighbor: single fallback wall
    Direction face = ctx.getHorizontalDirection().getOpposite();
    BooleanProperty flag = PROPERTY_BY_DIRECTION.get(face);

    return base.setValue(FACING, face).setValue(flag, true);
}
 /** after neighbour changes: keep only real connections or the lone fallback */
    @Override
    protected BlockState updateShape(BlockState state,
                                     Direction side,
                                     BlockState neighbour,
                                     LevelAccessor level,
                                     BlockPos pos,
                                     BlockPos neighbourPos) {

        state = super.updateShape(state, side, neighbour, level, pos, neighbourPos);

        int connected =
                (state.getValue(NORTH) ? 1 : 0) +
                (state.getValue(SOUTH) ? 1 : 0) +
                (state.getValue(EAST ) ? 1 : 0) +
                (state.getValue(WEST ) ? 1 : 0);

        Direction fallbackDir   = state.getValue(FACING);
        BooleanProperty fbFlag  = PROPERTY_BY_DIRECTION.get(fallbackDir);

        if (connected == 0) {
            state = state.setValue(fbFlag, true);          // isolated ⇒ show fallback
        } else if (!isNeighbourWall(level, pos, fallbackDir)) {
            state = state.setValue(fbFlag, false);         // connected ⇒ hide fallback
        }
        return state;
    }


    private boolean isNeighbourWall(LevelAccessor level, BlockPos pos, Direction dir) {
        return level.getBlockState(pos.relative(dir)).getBlock() instanceof OffsetQuarterPaneBlock;
    }


private static final VoxelShape CENTER_POST = Block.box(7, 0, 7, 9, 16, 9);

private static final VoxelShape NORTH_SHAPE = Block.box(0, 0, 0, 5, 16, 16);
private static final VoxelShape SOUTH_SHAPE = Block.box(11, 0, 0, 16, 16, 16);
private static final VoxelShape WEST_SHAPE  = Block.box(0, 0, 0, 16, 16, 5);
private static final VoxelShape EAST_SHAPE  = Block.box(0, 0, 11, 16, 16, 16);



    @Override
    public VoxelShape getShape(BlockState state, BlockGetter world, BlockPos pos, CollisionContext context) {
        boolean north = state.getValue(NORTH);
        boolean south = state.getValue(SOUTH);
        boolean east  = state.getValue(EAST);
        boolean west  = state.getValue(WEST);

        VoxelShape shape = CENTER_POST;

        if (north) shape = Shapes.or(shape, NORTH_SHAPE);
        if (south) shape = Shapes.or(shape, SOUTH_SHAPE);
        if (east)  shape = Shapes.or(shape, EAST_SHAPE);
        if (west)  shape = Shapes.or(shape, WEST_SHAPE);

        return shape;
    }

}
