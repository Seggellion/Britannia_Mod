package com.seggellion.britannia_mod.client;

import com.seggellion.britannia_mod.client.model.StoneFloorBakedModel;
import net.minecraft.client.resources.model.BakedModel;
import net.minecraft.client.resources.model.ModelResourceLocation;
import net.minecraft.resources.ResourceLocation;
import net.neoforged.neoforge.client.event.ModelEvent;

public class StoneFloorModelBaker {
    public static void onModelBake(ModelEvent.ModifyBakingResult event) {
      ResourceLocation blockModelId = ResourceLocation.fromNamespaceAndPath("britannia_mod", "block/structure/stone_floor");
        ModelResourceLocation modelId = new ModelResourceLocation(blockModelId, "");
        BakedModel existing = event.getModels().get(modelId);
        if (existing != null) {
            event.getModels().put(modelId, new StoneFloorBakedModel(existing));
        }
    }
}
