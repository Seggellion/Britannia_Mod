{
    "multipart": [
  

      { "when": { "half": "lower", "hinge": "left", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left" } },
      { "when": { "half": "lower", "hinge": "left", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left", "y":  90 } },
      { "when": { "half": "lower", "hinge": "left", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left", "y": 180 } },
      { "when": { "half": "lower", "hinge": "left", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left", "y": 270 } },
  
      { "when": { "half": "lower", "hinge": "left", "open": true,  "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left_open", "y": 90, "uvlock": true } },
      { "when": { "half": "lower", "hinge": "left", "open": true,  "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left_open", "y":   180, "uvlock": true } },
      { "when": { "half": "lower", "hinge": "left", "open": true,  "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left_open", "y":  270, "uvlock": true } },
      { "when": { "half": "lower", "hinge": "left", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_left_open", "y": 0, "uvlock": true } },
  

      { "when": { "half": "lower", "hinge": "right", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right" } },
      { "when": { "half": "lower", "hinge": "right", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right", "y":  90 } },
      { "when": { "half": "lower", "hinge": "right", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right", "y": 180 } },
      { "when": { "half": "lower", "hinge": "right", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right", "y": 270 } },
  
      { "when": { "half": "lower", "hinge": "right", "open": true,  "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right_open", "y":  270, "uvlock": true } },
      { "when": { "half": "lower", "hinge": "right", "open": true,  "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right_open", "y": 0, "uvlock": true } },
      { "when": { "half": "lower", "hinge": "right", "open": true,  "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right_open", "y": 90, "uvlock": true } },
      { "when": { "half": "lower", "hinge": "right", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_bottom_right_open", "y":   180, "uvlock": true } },
  

      { "when": { "half": "upper", "hinge": "left", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left" } },
      { "when": { "half": "upper", "hinge": "left", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left", "y":  90 } },
      { "when": { "half": "upper", "hinge": "left", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left", "y": 180 } },
      { "when": { "half": "upper", "hinge": "left", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left", "y": 270 } },
  
      { "when": { "half": "upper", "hinge": "left", "open": true,  "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left_open", "y": 90, "uvlock": true } },
      { "when": { "half": "upper", "hinge": "left", "open": true,  "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left_open", "y":   180, "uvlock": true } },
      { "when": { "half": "upper", "hinge": "left", "open": true,  "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left_open", "y":  270, "uvlock": true } },
      { "when": { "half": "upper", "hinge": "left", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_left_open", "y": 0, "uvlock": true } },
  

      { "when": { "half": "upper", "hinge": "right", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right" } },
      { "when": { "half": "upper", "hinge": "right", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right", "y":  90 } },
      { "when": { "half": "upper", "hinge": "right", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right", "y": 180 } },
      { "when": { "half": "upper", "hinge": "right", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right", "y": 270 } },
  
      { "when": { "half": "upper", "hinge": "right", "open": true,  "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right_open", "y":  270, "uvlock": true } },
      { "when": { "half": "upper", "hinge": "right", "open": true,  "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right_open", "y": 0, "uvlock": true } },
      { "when": { "half": "upper", "hinge": "right", "open": true,  "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right_open", "y": 90, "uvlock": true } },
      { "when": { "half": "upper", "hinge": "right", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/metal_door_top_right_open", "y":   180, "uvlock": true } }
    ]
  }
  