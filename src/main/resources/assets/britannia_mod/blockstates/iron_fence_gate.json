        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_right_open", "y": 0 } },
      { "when": { "part": "upper", "hinge": "right", "open": true,  "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_right_open", "y": 90 } },
      { "when": { "part": "upper", "hinge": "right", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_right_open", "y":   180 } }
    ]
