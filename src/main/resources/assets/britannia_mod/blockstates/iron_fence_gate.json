      { "when": { "part": "middle", "hinge": "right", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_middle_right_open", "y":   180 } },
  

      { "when": { "part": "upper", "hinge": "left", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left" } },
      { "when": { "part": "upper", "hinge": "left", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left", "y":  90 } },
      { "when": { "part": "upper", "hinge": "left", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left", "y": 180 } },
      { "when": { "part": "upper", "hinge": "left", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left", "y": 270 } },
  
      { "when": { "part": "upper", "hinge": "left", "open": true,  "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left_open", "y": 90 } },
      { "when": { "part": "upper", "hinge": "left", "open": true,  "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left_open", "y":   180 } },
      { "when": { "part": "upper", "hinge": "left", "open": true,  "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left_open", "y":  270 } },
      { "when": { "part": "upper", "hinge": "left", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_left_open", "y": 0 } },
  
      { "when": { "part": "upper", "hinge": "right", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_right" } },
      { "when": { "part": "upper", "hinge": "right", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_right", "y":  90 } },
      { "when": { "part": "upper", "hinge": "right", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_right", "y": 180 } },
      { "when": { "part": "upper", "hinge": "right", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_top_right", "y": 270 } },
  
