        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_middle_right", "y": 180 } },
      { "when": { "part": "middle", "hinge": "right", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_middle_right", "y": 270 } },
  
