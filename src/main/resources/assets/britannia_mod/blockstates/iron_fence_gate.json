{
    "multipart": [
      { "when": { "part": "lower", "hinge": "left", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_left" } },
      { "when": { "part": "lower", "hinge": "left", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_left", "y":  90 } },
      { "when": { "part": "lower", "hinge": "left", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_left", "y": 180 } },
      { "when": { "part": "lower", "hinge": "left", "open": false, "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_left", "y": 270 } },
  
      { "when": { "part": "lower", "hinge": "left", "open": true,  "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_left_open", "y": 90 } },
