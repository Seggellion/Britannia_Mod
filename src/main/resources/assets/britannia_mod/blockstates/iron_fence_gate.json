        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_left_open", "y":  270 } },
      { "when": { "part": "lower", "hinge": "left", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_left_open", "y": 0 } },
  
      { "when": { "part": "lower", "hinge": "right", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_right" } },
      { "when": { "part": "lower", "hinge": "right", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_right", "y":  90 } },
