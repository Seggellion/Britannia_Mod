        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_right", "y": 270 } },
  
      { "when": { "part": "lower", "hinge": "right", "open": true,  "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_right_open", "y":  270 } },
      { "when": { "part": "lower", "hinge": "right", "open": true,  "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_right_open", "y": 0 } },
      { "when": { "part": "lower", "hinge": "right", "open": true,  "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_right_open", "y": 90 } },
      { "when": { "part": "lower", "hinge": "right", "open": true,  "facing": "north" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_bottom_right_open", "y":   180 } },


      { "when": { "part": "middle", "hinge": "left", "open": false, "facing": "east"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_middle_left" } },
      { "when": { "part": "middle", "hinge": "left", "open": false, "facing": "south" },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_middle_left", "y":  90 } },
      { "when": { "part": "middle", "hinge": "left", "open": false, "facing": "west"  },
        "apply": { "model": "britannia_mod:block/structure/iron_fence_gate/iron_fence_gate_middle_left", "y": 180 } },
