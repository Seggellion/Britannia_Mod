# Simple cube for renderer testing
mtllib test_cube.mtl

o TestCube

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 -1 0
vn 0 1 0

# Face definitions

usemtl test_texture

f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/1/2 8/4/2 7/3/2 6/2/2
f 1/1/3 4/4/3 8/3/3 5/2/3
f 2/1/4 6/2/4 7/3/4 3/4/4
f 1/1/5 5/2/5 6/3/5 2/4/5
f 4/1/6 3/2/6 7/3/6 8/4/6
